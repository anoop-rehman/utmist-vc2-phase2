# Shared config for sync.sh / pull.sh
#
# BUCKET must already exist. Keep Public Access Prevention ON - these are your
# full chat transcripts.

GCS_PROJECT="vc2-2026"
GCS_BUCKET="vc2-2026-claude-code-state"   # bucket name only, no gs:// or trailing /
GCS_PREFIX="claude-code-state"   # folder inside the bucket

# Set to 1 to also sync .credentials.json (a live OAuth token).
# Default 0: on a new machine you just run `claude` and log in, which takes
# ~20s and avoids parking a live credential in object storage.
INCLUDE_CREDENTIALS=0
